# Vite 端口（与 Tauri.toml dev-url 一致）
DEV_SERVER_PORT=5180

# MQTT：只订阅 MQTT_MEASURE_TOPIC；载荷必须为一行文本（UTF-8），格式：
#   温度,湿度,光电
# 三个小数，英文逗号分隔，可含首尾空格。示例：23.5,60.0,0.12
# 解析代码：src-tauri/data/mod.rs 的 parse_measure_sample
MQTT_CLIENT_ID=measure-1
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE_SECS=5
MQTT_MEASURE_TOPIC=measure/data

# PostgreSQL（必填）：postgresql://用户:密码@主机:端口/库名
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/measure?sslmode=disable

# 按间隔把最近一次 MQTT 三值写入 `measure_samples`
MEASURE_PERSIST_INTERVAL_SECS=5

# 在线 RTSP → 本机 ffmpeg → var/stream/last.jpg（需 ffmpeg）
RTSP_RELAY_ENABLED=true
RTSP_RELAY_SOURCE=rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mp4
