# Vite 端口（与 Tauri.toml dev-url 一致）
DEV_SERVER_PORT=5180

# MQTT：仅订阅一个主题，载荷 CSV「温度,湿度,光电」
MQTT_CLIENT_ID=measure-1
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE_SECS=5
MQTT_MEASURE_TOPIC=measure/data

# 在线 RTSP → 本机 ffmpeg → var/stream/last.jpg（需已安装 ffmpeg）
RTSP_RELAY_ENABLED=false
RTSP_RELAY_SOURCE=
