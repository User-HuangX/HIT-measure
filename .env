# =============================================================================
# 【本应用自有】开发/进程内配置（与外部设备无直接协议绑定，可按本机端口占用修改）
# =============================================================================
# Vite 开发服务器端口；需与 Tauri.toml 的 dev-url 或 npm run tauri:dev 一致
DEV_SERVER_PORT=5180
# 本机 axum SSE 服务端口；前端通过 Vite 注入的地址连此端口推送测量 JSON
SSE_PORT=5888
# MQTT→SSE 广播通道容量；订阅者慢时可能丢弃最旧消息
SAMPLE_BROADCAST_CAPACITY=256

# =============================================================================
# 【对接外部】MQTT：连公共/自建 Broker，下列值需与 Broker 及「发布端设备」约定一致
# =============================================================================
# 客户端 ID，在 Broker 侧唯一；多实例同时连同一 Broker 时不要重复
MQTT_CLIENT_ID=test-1
# Broker 主机名或 IP（示例为 EMQX 公共测试节点，生产请换自有 Broker）
MQTT_BROKER_HOST=broker.emqx.io
# Broker 明文 MQTT 端口（TLS 时常为 8883，并需在代码里改传输方式）
MQTT_BROKER_PORT=1883
# 心跳间隔（秒），影响断线检测快慢
MQTT_KEEP_ALIVE_SECS=5
# 遗嘱主题/载荷：异常断线时由 Broker 代发（需 Broker 支持）
MQTT_WILL_TOPIC=hello/world
MQTT_WILL_PAYLOAD=good bye
# 【与设备/上位机约定】测量上行主题；载荷为 CSV：`温度,湿度,光电`（三个小数，逗号分隔）
MQTT_MEASURE_TOPIC=hit/measure/sample

# =============================================================================
# 【对接 + 本进程】xiu 流媒体服务：端口需与拉流/推流端、防火墙一致；日志级别为 xiu 库使用
# =============================================================================
XIU_RTMP_PORT=1935
XIU_RTSP_PORT=5544
XIU_WEBRTC_PORT=0
XIU_HTTP_FLV_PORT=8080
XIU_HLS_PORT=8081
XIU_LOG_LEVEL=info

# =============================================================================
# RTSP → HLS（ffmpeg，与本机 SSE 同端口提供 /hls/）；浏览器用 hls.js 播放，勿直接播 rtsp://
# =============================================================================
RTSP_RELAY_ENABLED=true
# 仅嵌入式 WebView（无 MSE）用 /mjpeg 时可设 false，避免与 MJPEG 双路 ffmpeg 拉同一 RTSP
RTSP_RELAY_WRITE_HLS=true
RTSP_RELAY_SOURCE=rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mp4
